@model SGA.Application.Dtos.RegistroAcceso.RegistroAccesoDto

<h2>Nuevo Registro de Acceso</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form action="/RegistroAcceso/Create" method="post">

    <div class="mb-3">
        <label>Usuario</label>

        <select name="UsuarioId" class="form-control">

            <option value="">Seleccione un usuario</option>

            @foreach (var usuario in ViewBag.Usuarios)
            {
                <option value="@usuario.Value">@usuario.Text</option>
            }

        </select>

    </div>

    <div class="mb-3">
        <label>Viaje</label>

        <select name="ViajeId" class="form-control">

            <option value="">Seleccione un viaje</option>

            @foreach (var viaje in ViewBag.Viajes)
            {
                <option value="@viaje.Value">@viaje.Text</option>
            }

        </select>

    </div>

    <div class="mb-3">
        <label>Permitido</label>
        <select name="Permitido" class="form-control">
            <option value="true">Sí</option>
            <option value="false">No</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Motivo</label>
        <input type="text" name="Motivo" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Fecha y Hora</label>
        <input type="datetime-local" name="FechaHora" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a href="/RegistroAcceso/Index" class="btn btn-secondary">
        Volver
    </a>

</form>
