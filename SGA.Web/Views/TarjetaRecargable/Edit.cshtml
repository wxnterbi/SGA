@model SGA.Application.Dtos.TarjetaRecargable.TarjetaRecargableDto

@{
    ViewData["Title"] = "Editar Tarjeta";
}

<h2>Editar Tarjeta Recargable</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form action="/TarjetaRecargable/Edit" method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label>Usuario</label>
        <input type="number"
               name="UsuarioId"
               value="@Model.UsuarioId"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Saldo</label>
        <input type="number"
               step="0.01"
               name="Saldo"
               value="@Model.Saldo"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Estado</label>
        <select name="Estado" class="form-control">
            <option value="1" @(Model.Estado == 1 ? "selected" : "")>Activa</option>
            <option value="2" @(Model.Estado == 2 ? "selected" : "")>Bloqueada</option>
            <option value="3" @(Model.Estado == 3 ? "selected" : "")>Vencida</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar Cambios
    </button>

    <a href="/TarjetaRecargable" class="btn btn-secondary">
        Cancelar
    </a>

</form>