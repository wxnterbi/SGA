@model SGA.Application.Dtos.TicketMensual.TicketMensualDto

<h2>Editar Ticket Mensual</h2>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        @foreach (var estado in ViewData.ModelState.Values)
        {
            foreach (var error in estado.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
    </div>
}

<form action="/TicketMensual/Edit" method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label>Usuario</label>

        <select name="UsuarioId" class="form-control">

            @foreach (var usuario in ViewBag.Usuarios)
            {
                if (Model.UsuarioId.ToString() == usuario.Value)
                {
                    <option value="@usuario.Value" selected>
                        @usuario.Text
                    </option>
                }
                else
                {
                    <option value="@usuario.Value">
                        @usuario.Text
                    </option>
                }
            }

        </select>
    </div>

    <div class="mb-3">
        <label>Pago</label>

        <select name="PagoId" class="form-control">

            @foreach (var pago in ViewBag.Pagos)
            {
                if (Model.PagoId.ToString() == pago.Value)
                {
                    <option value="@pago.Value" selected>
                        Pago #@pago.Value
                    </option>
                }
                else
                {
                    <option value="@pago.Value">
                        Pago #@pago.Value
                    </option>
                }
            }

        </select>
    </div>

    <div class="mb-3">
        <label>Fecha Inicio</label>

        <input type="date"
               name="FechaInicio"
               class="form-control"
               value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />

    </div>

    <div class="mb-3">
        <label>Fecha Fin</label>

        <input type="date"
               name="FechaFin"
               class="form-control"
               value="@Model.FechaFin.ToString("yyyy-MM-dd")" />

    </div>

    <div class="mb-3">

        <label>Estado</label>

        <select name="Estado" class="form-control">

            @if (Model.Estado == 1)
            {
                <option value="1" selected>Activo</option>
            }
            else
            {
                <option value="1">Activo</option>
            }

            @if (Model.Estado == 2)
            {
                <option value="2" selected>Vencido</option>
            }
            else
            {
                <option value="2">Vencido</option>
            }

            @if (Model.Estado == 3)
            {
                <option value="3" selected>Cancelado</option>
            }
            else
            {
                <option value="3">Cancelado</option>
            }

        </select>

    </div>

    <button type="submit" class="btn btn-warning">
        Guardar Cambios
    </button>

    <a href="/TicketMensual" class="btn btn-secondary">
        Volver
    </a>

</form>