@model SGA.Application.Dtos.TicketMensual.TicketMensualDto

<h2>Detalles del Ticket</h2>

<table class="table table-bordered">

    <tr>
        <th>Id</th>
        <td>@Model.Id</td>
    </tr>

    <tr>
        <th>Usuario</th>
        <td>@Model.UsuarioId</td>
    </tr>

    <tr>
        <th>Pago</th>
        <td>@Model.PagoId</td>
    </tr>

    <tr>
        <th>Fecha Inicio</th>
        <td>@Model.FechaInicio.ToShortDateString()</td>
    </tr>

    <tr>
        <th>Fecha Fin</th>
        <td>@Model.FechaFin.ToShortDateString()</td>
    </tr>

    <tr>
        <th>Estado</th>
        <td>@((SGA.Domain.Enums.Reservation.EstadoTicket)Model.Estado)</td>
    </tr>

</table>

<a href="/TicketMensual" class="btn btn-secondary">
    Volver
</a>
