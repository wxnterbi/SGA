@model SGA.Application.Dtos.Pago.PagoDto

<h2>Editar Pago</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
            <div>@error.ErrorMessage</div>
        }
    </div>
}

<form action="/Pago/Edit" method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label>Usuario</label>
        <input type="number" name="UsuarioId" value="@Model.UsuarioId" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Monto</label>
        <input type="number" step="0.01" name="Monto" value="@Model.Monto" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Fecha</label>
        <input type="datetime-local"
               name="FechaPago"
               value="@Model.FechaPago.ToString("yyyy-MM-ddTHH:mm")"
               class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Modalidad</label>
        <input type="text" name="Modalidad" value="@Model.Modalidad" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar Cambios
    </button>

    <a href="/Pago/Index" class="btn btn-secondary">
        Volver
    </a>

</form>
