<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - SGA</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="icon"
          type="image/png"
          href="~/images/favicon.png" />

</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark">

            <div class="container">

                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="fa-solid fa-bus"></i>

                    SGA

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                <div class="collapse navbar-collapse" id="menu">

               <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav ms-auto">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="fa-solid fa-house"></i>

                                Inicio

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Pago"
                               asp-action="Index">

                                <i class="fa-solid fa-ticket"></i>

                                Reservar Ticket

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="TicketMensual"
                               asp-action="Index">

                                <i class="fa-solid fa-calendar-check"></i>

                               Tickets Mensuales

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="TarjetaRecargable"
                               asp-action="Index">

                                <i class="fa-solid fa-credit-card"></i>

                                Recargar Saldo

                            </a>

                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="RegistroAcceso"
                               asp-action="MisAccesos">

                                <i class="fa-solid fa-door-open"></i>
                                Mis Accesos

                            </a>
                        </li>

                        <li class="nav-item">

                        <li class="nav-item">
                            <a class="nav-link"
                                asp-controller="Notificacion"
                                asp-action="Index">

                              <i class="fa-solid fa-bell"></i>
                              Avisos

                               </a>
                          </li>
                            </a>
                        </li>
                    </ul>
                </div>

               </div>

            </div>

        </nav>

    </header>

    <main class="container py-4">

        @RenderBody()

    </main>

    <footer class="footer">

        <div class="container">

            <hr />

            <p>

                © @DateTime.Now.Year - Sistema de Gestión de Autobuses (SGA)

            </p>

        </div>

    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
