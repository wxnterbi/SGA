@model SGA.Web.Models.TarjetaRecargable.TarjetaRecargableViewModel

@{
    ViewData["Title"] = "Eliminar";
}

<h2>Eliminar Tarjeta</h2>

<h4>¿Está seguro de eliminar esta tarjeta?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@Model.UsuarioId</dd>

    <dt class="col-sm-3">Saldo</dt>
    <dd class="col-sm-9">@Model.Saldo</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>

</dl>

<form asp-action="Delete">

    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">Eliminar</button>

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>
