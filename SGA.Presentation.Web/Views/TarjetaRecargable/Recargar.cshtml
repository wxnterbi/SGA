@model SGA.Web.Models.TarjetaRecargable.RecargarSaldoViewModel

@{
    ViewData["Title"] = "Recargar Tarjeta";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow border-0 rounded-4">

                <div class="card-header bg-primary text-white text-center py-4">

                    <h2>
                        <i class="fa-solid fa-wallet"></i>
                        Recargar Tarjeta
                    </h2>

                </div>

                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                    <form asp-action="Recargar" method="post">

                        <input asp-for="TarjetaId" type="hidden" />
                        <input asp-for="UsuarioId" type="hidden" />

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Saldo Actual
                            </label>

                            <input class="form-control"
                                   value="RD$ @Model.SaldoActual.ToString("N2")"
                                   readonly />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Monto" class="form-label fw-bold">
                                Monto a Recargar
                            </label>

                            <input asp-for="Monto"
                                   class="form-control"
                                   min="1"
                                   max="5000"
                                   step="1"
                                   placeholder="Ej. 500" />

                            <span asp-validation-for="Monto"
                                  class="text-danger"></span>

                        </div>

                        <hr />

                        <h5 class="mb-3">
                            Datos de la tarjeta
                        </h5>

                        <div class="mb-3">

                            <label asp-for="NumeroTarjeta"
                                   class="form-label fw-bold">
                                Número de Tarjeta
                            </label>

                            <input asp-for="NumeroTarjeta"
                                   class="form-control"
                                   maxlength="19"
                                   autocomplete="off"
                                   placeholder="1234 5678 9012 3456" />

                            <span asp-validation-for="NumeroTarjeta"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-3">

                            <label asp-for="NombreTitular"
                                   class="form-label fw-bold">
                                Nombre del Titular
                            </label>

                            <input asp-for="NombreTitular"
                                   class="form-control"
                                   autocomplete="off"
                                   placeholder="NOMBRE APELLIDO"
                                   style="text-transform:uppercase;" />

                            <span asp-validation-for="NombreTitular"
                                  class="text-danger"></span>

                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label asp-for="FechaExpiracion"
                                       class="form-label fw-bold">
                                    Fecha de Expiración
                                </label>

                                <input asp-for="FechaExpiracion"
                                       class="form-control"
                                       maxlength="5"
                                       autocomplete="off"
                                       placeholder="MM/AA" />

                                <span asp-validation-for="FechaExpiracion"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6 mb-3">

                                <label asp-for="CVV"
                                       class="form-label fw-bold">
                                    CVV
                                </label>

                                <input asp-for="CVV"
                                       class="form-control"
                                       maxlength="3"
                                       autocomplete="off"
                                       placeholder="123" />

                                <span asp-validation-for="CVV"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <div class="text-center mt-4">

                            <button type="submit"
                                    class="btn btn-success btn-lg px-5">

                                <i class="fa-solid fa-credit-card"></i>

                                Confirmar Recarga

                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.TarjetaId"
                               class="btn btn-secondary btn-lg ms-3">

                                Cancelar

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        // Número de tarjeta
        document.getElementById("NumeroTarjeta").addEventListener("input", function () {

            let valor = this.value.replace(/\D/g, "");

            valor = valor.substring(0,16);

            valor = valor.replace(/(.{4})/g, "$1 ").trim();

            this.value = valor;

        });

        // Nombre del titular
        document.getElementById("NombreTitular").addEventListener("input", function () {

            this.value = this.value
                .replace(/[^A-Za-zÁÉÍÓÚáéíóúÑñ ]/g,"")
                .toUpperCase();

        });

        // Fecha MM/AA
        document.getElementById("FechaExpiracion").addEventListener("input", function () {

            let valor = this.value.replace(/\D/g, "");

            if (valor.length > 4)
                valor = valor.substring(0,4);

            if (valor.length > 2)
                valor = valor.substring(0,2) + "/" + valor.substring(2);

            this.value = valor;

        });

        // CVV
        document.getElementById("CVV").addEventListener("input", function () {

            this.value = this.value
                .replace(/\D/g,"")
                .substring(0,3);

        });

        // Monto
        document.getElementById("Monto").addEventListener("input", function () {

            if (this.value < 0)
                this.value = "";

            if (this.value > 5000)
                this.value = 5000;

        });

    </script>

}
