@model SGA.Web.Models.TarjetaRecargable.TarjetaRecargableViewModel

@{
    ViewData["Title"] = "Crear Tarjeta";
}

<h2>Crear Tarjeta Recargable</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label asp-for="UsuarioId"></label>
        <input asp-for="UsuarioId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Saldo"></label>
        <input asp-for="Saldo" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Estado"></label>
        <input asp-for="Estado" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>
