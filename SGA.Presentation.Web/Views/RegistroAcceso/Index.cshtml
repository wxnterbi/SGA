@model IEnumerable<SGA.Web.Models.RegistroAcceso.RegistroAccesoViewModel>

@{
    ViewData["Title"] = "Mis Accesos";
}

<h2 class="mb-4">
    <i class="fa-solid fa-bus"></i>
    Mis Accesos
</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No existen registros de acceso.
    </div>
}
else
{
    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-lg-6 mb-4">

                <div class="card shadow border-0">

                    <div class="card-header @(item.Permitido ? "bg-primary" : "bg-danger") text-white">

                        <h5 class="mb-0">

                            @if (item.Permitido)
                            {
                                <i class="fa-solid fa-circle-check"></i>
                                <span>Acceso Permitido</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle-xmark"></i>
                                <span>Acceso Denegado</span>
                            }

                        </h5>

                    </div>

                    <div class="card-body">

                        <p>
                            <strong>
                                <i class="fa-solid fa-calendar"></i>
                                Fecha
                            </strong>
                            <br />
                            @item.FechaHora.ToString("dd/MM/yyyy")
                        </p>

                        <hr />

                        <p>
                            <strong>
                                <i class="fa-solid fa-clock"></i>
                                Hora
                            </strong>
                            <br />
                            @item.FechaHora.ToString("hh:mm tt")
                        </p>

                        <hr />

                        <p>
                            <strong>
                                <i class="fa-solid fa-bus"></i>
                                Viaje
                            </strong>
                            <br />
                            #@item.ViajeId
                        </p>

                        <hr />

                        <p>
                            <strong>
                                <i class="fa-solid fa-circle-info"></i>
                                Motivo
                            </strong>
                            <br />
                            @item.Motivo
                        </p>

                    </div>

                    <div class="card-footer text-end">

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary">

                            <i class="fa-solid fa-eye"></i>

                            Ver detalles

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}
