@model IEnumerable<SGA.Web.Models.TicketMensual.TicketMensualViewModel>

@{
    ViewData["Title"] = "Tickets Mensuales";
}

<h2>Tickets Mensuales</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nuevo Ticket</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Pago</th>
            <th>Fecha Inicio</th>
            <th>Fecha Fin</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UsuarioId</td>
                <td>@item.PagoId</td>
                <td>@item.FechaInicio</td>
                <td>@item.FechaFin</td>
                <td>@item.Estado</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
