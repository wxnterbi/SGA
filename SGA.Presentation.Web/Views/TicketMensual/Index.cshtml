@model IEnumerable<SGA.Web.Models.TicketMensual.TicketMensualViewModel>

@{
    ViewData["Title"] = "Mis Tickets Mensuales";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="fa-solid fa-ticket text-primary"></i>
                Mis Tickets Mensuales
            </h2>

            <p class="text-muted mb-0">
                Consulta el estado y la vigencia de tus tickets.
            </p>
        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">

            <i class="fa-solid fa-circle-info"></i>

            No tienes tickets mensuales registrados.

        </div>
    }
    else
    {
        <div class="row">

            @foreach (var item in Model.OrderByDescending(x => x.FechaInicio))
            {
                var diasRestantes = (item.FechaFin.Date - DateTime.Today).Days;
                var vigente = diasRestantes >= 0;

                var porcentaje = vigente
                ? Math.Min((diasRestantes * 100) / 30, 100)
                : 0;

                <div class="col-lg-6 col-xl-4 mb-4">

                    <div class="card border-0 shadow-lg h-100">

                        <div class="card-header @(vigente ? "bg-primary" : "bg-danger") text-white">

                            <div class="d-flex justify-content-between align-items-center">

                                <h5 class="mb-0">
                                    <i class="fa-solid fa-ticket"></i>
                                    Ticket Mensual
                                </h5>

                                <span class="badge bg-warning text-dark">
                                    Mensual
                                </span>

                            </div>

                        </div>

                        <div class="card-body">

                            <div class="text-center mb-4">

                                <i class="fa-solid fa-ticket fa-4x text-primary"></i>

                            </div>

                            <p class="mb-3">
                                <strong>
                                    <i class="fa-solid fa-id-card"></i>
                                    Matrícula
                                </strong>
                                <br />
                                @item.Matricula
                            </p>

                            <p class="mb-3">
                                <strong>
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                    Precio
                                </strong>
                                <br />
                                <span class="text-success fw-bold">
                                    RD$850.00
                                </span>
                            </p>

                            <hr />

                            <p>

                                <strong>

                                    <i class="fa-solid fa-calendar-days"></i>

                                    Vigencia

                                </strong>

                                <br />

                                @item.FechaInicio.ToString("dd/MM/yyyy")

                                <br />

                                al

                                <br />

                                @item.FechaFin.ToString("dd/MM/yyyy")

                            </p>

                            <div class="progress mb-2" style="height:10px">

                                <div class="progress-bar bg-primary"
                                     style="width:@porcentaje%">
                                </div>

                            </div>

                            @if (vigente)
                            {
                                <div class="text-primary fw-bold mb-3">

                                    Quedan @diasRestantes días

                                </div>
                            }
                            else
                            {
                                <div class="text-danger fw-bold mb-3">

                                    Ticket vencido

                                </div>
                            }

                            <hr />

                            <p>

                                <strong>

                                    <i class="fa-solid fa-route"></i>

                                    Ruta

                                </strong>

                                <br />

                                <small class="text-muted">

                                    Entrada:

                                </small>

                                @item.RutaEntrada

                                <br />

                                <small class="text-muted">

                                    Salida:

                                </small>

                                @item.RutaSalida

                            </p>

                            <p>

                                <strong>

                                    <i class="fa-solid fa-clock"></i>

                                    Horarios

                                </strong>

                                <br />

                                <small class="text-muted">

                                    Entrada:

                                </small>

                                @item.HorarioEntrada

                                <br />

                                <small class="text-muted">

                                    Salida:

                                </small>

                                @item.HorarioSalida

                            </p>

                            <p>

                                <strong>

                                    <i class="fa-solid fa-location-dot"></i>

                                    Paradas

                                </strong>

                                <br />

                                <small class="text-muted">

                                    Entrada:

                                </small>

                                @item.ParadaEntrada

                                <br />

                                <small class="text-muted">

                                    Salida:

                                </small>

                                @item.ParadaSalida

                            </p>

                        </div>

                        <div class="card-footer bg-white">

                            <div class="d-flex justify-content-between align-items-center">

                                @if (vigente)
                                {
                                    <span class="badge bg-primary fs-6">

                                        <i class="fa-solid fa-circle-check"></i>

                                        ACTIVO

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">

                                        <i class="fa-solid fa-circle-xmark"></i>

                                        VENCIDO

                                    </span>
                                }

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary">

                                    <i class="fa-solid fa-eye"></i>

                                    Ver detalles

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
