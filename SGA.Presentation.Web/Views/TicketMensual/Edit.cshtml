@model SGA.Web.Models.TicketMensual.TicketMensualViewModel

@{
    ViewData["Title"] = "Editar Ticket";
}

<h2>Editar Ticket</h2>

<form asp-action="Edit">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="UsuarioId"></label>
        <input asp-for="UsuarioId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PagoId"></label>
        <input asp-for="PagoId" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaInicio"></label>
        <input asp-for="FechaInicio" class="form-control" type="datetime-local" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaFin"></label>
        <input asp-for="FechaFin" class="form-control" type="datetime-local" />
    </div>

    <div class="mb-3">
        <label asp-for="Estado"></label>
        <input asp-for="Estado" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>
