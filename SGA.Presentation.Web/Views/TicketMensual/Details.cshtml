@model SGA.Web.Models.TicketMensual.TicketMensualViewModel

@{
    ViewData["Title"] = "Detalles";
}

<h2>Detalles del Ticket</h2>

<hr />

<dl class="row">

    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@Model.UsuarioId</dd>

    <dt class="col-sm-3">Pago</dt>
    <dd class="col-sm-9">@Model.PagoId</dd>

    <dt class="col-sm-3">Fecha Inicio</dt>
    <dd class="col-sm-9">@Model.FechaInicio</dd>

    <dt class="col-sm-3">Fecha Fin</dt>
    <dd class="col-sm-9">@Model.FechaFin</dd>

    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@Model.Estado</dd>

</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>