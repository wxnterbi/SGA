@model SGA.Web.Models.TicketMensual.TicketMensualViewModel

@{
    ViewData["Title"] = "Comprobante del Ticket Mensual";

    bool vigente = Model.FechaFin.Date >= DateTime.Today;
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="card shadow border-0">

                <div class="card-header @(vigente ? "bg-primary" : "bg-danger") text-white">

                    <div class="d-flex justify-content-between align-items-center">

                        <h3 class="mb-0">
                            <i class="fa-solid fa-ticket"></i>
                            Comprobante de Ticket Mensual
                        </h3>

                        <span class="badge bg-warning text-dark fs-6">
                            Ticket #@Model.Id
                        </span>

                    </div>

                </div>

                <div class="card-body">

                    <div class="alert alert-primary border-0">

                        <i class="fa-solid fa-circle-info"></i>

                        Este comprobante acredita un ticket mensual válido para el servicio de transporte universitario durante el período indicado.

                    </div>

                    <div class="text-center mb-4">

                        <div class="bg-primary rounded-circle d-inline-flex justify-content-center align-items-center"
                             style="width:110px;height:110px;">

                            <i class="fa-solid fa-ticket text-white fa-3x"></i>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <div class="card border-primary shadow-sm mb-3">

                                <div class="card-header bg-primary text-white">

                                    <strong>
                                        <i class="fa-solid fa-user"></i>
                                        Información del Usuario
                                    </strong>

                                </div>

                                <div class="card-body">

                                    <p>

                                        <strong>Matrícula</strong>

                                        <br />

                                        @Model.Matricula

                                    </p>

                                    <p>

                                        <strong>Precio</strong>

                                        <br />

                                        <span class="fw-bold text-primary">

                                            RD$850.00

                                        </span>

                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="card border-primary shadow-sm mb-3">

                                <div class="card-header bg-primary text-white">

                                    <strong>

                                        <i class="fa-solid fa-calendar-days"></i>

                                        Vigencia

                                    </strong>

                                </div>

                                <div class="card-body">

                                    <p>

                                        <strong>Fecha Inicio</strong>

                                        <br />

                                        @Model.FechaInicio.ToString("dd/MM/yyyy")

                                    </p>

                                    <p>

                                        <strong>Fecha Fin</strong>

                                        <br />

                                        @Model.FechaFin.ToString("dd/MM/yyyy")

                                    </p>

                                    @if (vigente)
                                    {
                                        <span class="badge bg-primary fs-6">

                                            <i class="fa-solid fa-circle-check"></i>

                                            ACTIVO

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger fs-6">

                                            <i class="fa-solid fa-circle-xmark"></i>

                                            VENCIDO

                                        </span>
                                    }

                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <div class="card border-primary shadow-sm">

                                <div class="card-header bg-light">

                                    <h5 class="text-primary mb-0">

                                        <i class="fa-solid fa-arrow-right"></i>

                                        Trayecto de Entrada

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <p>

                                        <strong>Ruta</strong>

                                        <br />

                                        @Model.RutaEntrada

                                    </p>

                                    <p>

                                        <strong>Horario</strong>

                                        <br />

                                        @Model.HorarioEntrada

                                    </p>

                                    <p>

                                        <strong>Parada</strong>

                                        <br />

                                        @Model.ParadaEntrada

                                    </p>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="card border-primary shadow-sm">

                                <div class="card-header bg-light">

                                    <h5 class="text-primary mb-0">

                                        <i class="fa-solid fa-arrow-left"></i>

                                        Trayecto de Salida

                                    </h5>

                                </div>

                                <div class="card-body">

                                    <p>

                                        <strong>Ruta</strong>

                                        <br />

                                        @Model.RutaSalida

                                    </p>

                                    <p>

                                        <strong>Horario</strong>

                                        <br />

                                        @Model.HorarioSalida

                                    </p>

                                    <p>

                                        <strong>Parada</strong>

                                        <br />

                                        @Model.ParadaSalida

                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="card-footer bg-white">

                    <div class="d-flex justify-content-between">

                        <a asp-action="Index" class="btn btn-secondary">

                            <i class="fa-solid fa-arrow-left"></i>

                            Volver

                        </a>

                        <button class="btn btn-primary"
                                onclick="window.print()">

                            <i class="fa-solid fa-print"></i>

                            Imprimir comprobante

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>