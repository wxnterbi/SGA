@model IEnumerable<SGA.Web.Models.Notificacion.NotificacionViewModel>

@{
    ViewData["Title"] = "Notificaciones";
}

<h2>Notificaciones</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Nueva Notificación</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Tipo Evento</th>
            <th>Mensaje</th>
            <th>Fecha Hora</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.UsuarioId</td>
                <td>@item.TipoEvento</td>
                <td>@item.Mensaje</td>
                <td>@item.FechaHora</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
