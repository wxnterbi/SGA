@model SGA.Web.Models.Notificacion.NotificacionViewModel

@{
    ViewData["Title"] = "Detalles";
}

<h2>Detalles de la Notificación</h2>

<hr />

<dl class="row">

    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@Model.UsuarioId</dd>

    <dt class="col-sm-3">Tipo Evento</dt>
    <dd class="col-sm-9">@Model.TipoEvento</dd>

    <dt class="col-sm-3">Mensaje</dt>
    <dd class="col-sm-9">@Model.Mensaje</dd>

    <dt class="col-sm-3">Fecha Hora</dt>
    <dd class="col-sm-9">@Model.FechaHora</dd>

</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
