@model SGA.Web.Models.Pago.PagoViewModel

@{
    ViewData["Title"] = "Eliminar Pago";
}

<h2>Eliminar Pago</h2>

<h4>¿Está seguro de que desea eliminar este pago?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Usuario
    </dt>

    <dd class="col-sm-9">
        @Model.UsuarioId
    </dd>

    <dt class="col-sm-3">
        Monto
    </dt>

    <dd class="col-sm-9">
        @Model.Monto
    </dd>

    <dt class="col-sm-3">
        Fecha de Pago
    </dt>

    <dd class="col-sm-9">
        @Model.FechaPago
    </dd>

    <dt class="col-sm-3">
        Modalidad
    </dt>

    <dd class="col-sm-9">
        @Model.Modalidad
    </dd>

</dl>

<form asp-action="Delete">

    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>
