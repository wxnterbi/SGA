@model SGA.Application.Dtos.Viaje.ViajeDto

<h2>Eliminar Viaje</h2>

<div class="alert alert-danger">
    ¿Está seguro de eliminar este viaje?
</div>

<table class="table table-bordered">

    <tr>
        <th>Ruta</th>
        <td>@Model.RutaId</td>
    </tr>

    <tr>
        <th>Horario</th>
        <td>@Model.HorarioId</td>
    </tr>

    <tr>
        <th>Autobús</th>
        <td>@Model.AutobusId</td>
    </tr>

    <tr>
        <th>Conductor</th>
        <td>@Model.ConductorId</td>
    </tr>

    <tr>
        <th>Estado</th>
        <td>@Model.Estado</td>
    </tr>

</table>

<form action="/Viaje/Delete/@Model.Id" method="post">

    <button type="submit" class="btn btn-danger">
        Eliminar
    </button>

    <a href="/Viaje" class="btn btn-secondary">
        Cancelar
    </a>

</form>
