@model IEnumerable<SGA.Application.Dtos.Usuario.UsuarioDto>

<h1>Usuarios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Usuario
    </a>
</p>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Id</th>
            <th>Identificador</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.IdentificadorInstitucional</td>
                <td>@item.Nombre</td>
                <td>@item.TipoUsuario</td>
                <td>@item.Estado</td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info">
                        Detalles
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger">
                        Eliminar
                    </a>

                </td>
            </tr>
        }

    </tbody>

</table>
