@model SGA.Application.Dtos.Usuario.UsuarioDto

<h2>Detalle Usuario</h2>

<p><b>Id:</b> @Model.Id</p>

<p><b>Identificador:</b> @Model.IdentificadorInstitucional</p>

<p><b>Nombre:</b> @Model.Nombre</p>

<p><b>Tipo:</b> @Model.TipoUsuario</p>

<p><b>Estado:</b> @Model.Estado</p>

<a href="/Usuario/Edit/@Model.Id" class="btn btn-warning">
    Editar
</a>

<a href="/Usuario" class="btn btn-secondary">
    Volver
</a>


