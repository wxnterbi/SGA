@model SGA.Application.Dtos.Ruta.RutaDto

<h2>Detalle de Ruta</h2>

<table class="table table-bordered">

    <tr>
        <th>Nombre</th>
        <td>@Model.Nombre</td>
    </tr>

    <tr>
        <th>Origen</th>
        <td>@Model.Origen</td>
    </tr>

    <tr>
        <th>Destino</th>
        <td>@Model.Destino</td>
    </tr>

</table>

<a href="/Ruta/Edit/@Model.Id" class="btn btn-warning">
    Editar
</a>

<a href="/Ruta" class="btn btn-secondary">Volver</a>
