@model SGA.Application.Dtos.Auditoria.AuditoriaDto

<h2>Nueva Auditoria</h2>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        @foreach (var estado in ViewData.ModelState.Values)
        {
            foreach (var error in estado.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
    </div>
}

<form action="/Auditoria/Create" method="post">

    <div class="mb-3">
        <label>Auditor</label>
        <input type="text" name="Actor" class="form-control" value="@Model?.Actor" />
    </div>

    <div class="mb-3">
        <label>Tipo de Acción</label>

        <select asp-for="TipoAccion" class="form-control">

            <option value="1">Creador</option>
            <option value="2">Supervisor</option>
            <option value="3">Modificador</option>
            <option value="4">Eliminador</option>

        </select>

    </div>

    </div>

    <div class="mb-3">
        <label>Descripción</label>
        <input type="text" name="Descripcion" class="form-control" value="@Model?.Descripcion" />
    </div>

    <div class="mb-3">
        <label>Fecha y Hora</label>
        <input type="datetime-local" name="FechaHora" class="form-control" />
    </div>

    <button class="btn btn-success">Guardar</button>

    <a href="/Horario" class="btn btn-secondary">Volver</a>

</form>
