@model SGA.Application.Dtos.Auditoria.AuditoriaDto

<h2>Detalle de Auditoria</h2>

<table class="table table-bordered">

    <tr>
        <th>Auditor</th>
        <td>@Model.Actor</td>
    </tr>

    <tr>
        <th>Accion</th>
        <td>@Model.TipoAccion</td>
    </tr>

    <tr>
        <th>Descripcion</th>
        <td>@Model.Descripcion</td>
    </tr>

    <tr>
        <th>FechaHora</th>
        <td>@Model.FechaHora</td>
    </tr>

</table>

<a href="/Auditoria" class="btn btn-secondary">Volver</a>
