@model SGA.Application.Dtos.Autobus.AutobusDto

<h2>Eliminar Autobús</h2>

<h4>¿Desea eliminar este autobús?</h4>

<p>@Model.Placa</p>

<form asp-action="Delete">

    <input asp-for="Id" type="hidden" />

    <button class="btn btn-danger">
        Eliminar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancelar
    </a>

</form>
