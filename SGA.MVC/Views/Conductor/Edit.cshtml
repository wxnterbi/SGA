@model SGA.Application.Dtos.Conductor.ConductorDto

<h2>Editar Conductor</h2>

@if (ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger">
        @foreach (var estado in ViewData.ModelState.Values)
        {
            foreach (var error in estado.Errors)
            {
                <div>@error.ErrorMessage</div>
            }
        }
    </div>
}

<form action="/Conductor/Edit" method="post">

    <input type="hidden" name="Id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input type="text" name="Nombre" class="form-control" value="@Model.Nombre" />
    </div>

    <div class="mb-3">
        <label class="form-label">Teléfono</label>
        <input type="text" name="Telefono" class="form-control" value="@Model.Telefono" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cédula</label>
        <input type="text" name="Cedula" class="form-control" value="@Model.Cedula" />
    </div>

    <div class="mb-3">
        <label class="form-label">Licencia</label>
        <input type="text" name="Licencia" class="form-control" value="@Model.Licencia" />
    </div>

    <div class="mb-3">
        <label class="form-label">Estado</label>
        <select name="EstadoConductorId" class="form-control">
            <option value="1">Activo</option>
            <option value="2">Vacaciones</option>
            <option value="3">Suspendido</option>
            <option value="4">Retirado</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Actualizar
    </button>

    <a href="/Conductor" class="btn btn-secondary">Volver</a>
</form>