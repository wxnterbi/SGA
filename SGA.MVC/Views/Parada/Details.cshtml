@model SGA.Application.Dtos.Parada.ParadaDto

<h2>Detalle de Parada</h2>

<table class="table table-bordered">

    <tr>
        <th>Nombre</th>
        <td>@Model.Nombre</td>
    </tr>

    <tr>
        <th>Ubicación</th>
        <td>@Model.Ubicacion</td>
    </tr>

    <tr>
        <th>Orden</th>
        <td>@Model.Orden</td>
    </tr>

</table>

<a href="/Parada/Edit/@Model.Id" class="btn btn-warning">
    Editar
</a>

<a href="/Parada" class="btn btn-secondary">Volver</a>
